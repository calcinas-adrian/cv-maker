# Neon Postgres connection string (pooled connection recommended)
DATABASE_URL=

# Random 32+ byte secret used by Better Auth to sign sessions/cookies.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Base URL of this app (no trailing slash).
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth App credentials (github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# WebAuthn / passkey relying party config.
# RP ID must be the domain (no scheme/port), e.g. "localhost" in dev
# or "example.com" in production.
PASSKEY_RP_ID=localhost
PASSKEY_RP_NAME=CV AI

# AES-256-GCM master key (hex, 32 bytes) used to encrypt stored BYOK API keys.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=
